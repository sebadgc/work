# Opcional: valores iniciales. También se pueden cargar desde la web (Ajustes ⚙).
# Para usarlos, copiá este archivo a ".env" y exportá las variables, o seteálas
# en tu sistema antes de "npm start". (La config editada desde la web se guarda
# en data/config.json y tiene prioridad.)

# Puerto del servidor (lo que abrís en el celu: http://IP-de-tu-PC:PUERTO)
PORT=8088

# qBittorrent → Herramientas → Opciones → Web UI
QB_URL=http://localhost:8080
QB_USER=admin
QB_PASS=adminadmin

# Indexador de búsqueda (Jackett "all" o Prowlarr) en formato Torznab
# Jackett: copiá el "Torznab Feed" del indexador "all" y su API Key.
INDEXER_URL=
INDEXER_APIKEY=

# Carpeta de destino opcional (vacío = la default de qBittorrent)
SAVE_PATH=
